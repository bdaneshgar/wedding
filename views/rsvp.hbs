<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>RSVP | Hannah & Brian</title>
  <meta name="viewport" content="width=device-width, initial-scale=1" />

  <!-- Optional upscale font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;500&display=swap" rel="stylesheet">

  <style>
    body {
      margin: 0;
      padding: 0;
      background-color: #faf9f6;
      font-family: system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    }

    .container {
      max-width: 900px;
      margin: 0 auto;
      padding: 2.5rem 1.5rem;
    }

    .header {
      text-align: center;
      margin-bottom: 2.2rem;
    }

    .names {
      font-family: "Playfair Display", serif;
      font-size: 1.7rem;
      text-transform: uppercase;
      letter-spacing: 0.18em;
    }

    .hebrew {
      margin-top: 0.4rem;
      font-size: 0.95rem;
      letter-spacing: 0.12em;
    }

    .date-line {
      margin-top: 0.6rem;
      font-size: 0.9rem;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .rsvp-title {
      margin: 2rem 0 1.2rem;
      text-align: center;
      font-family: "Playfair Display", serif;
      font-size: 1.4rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
    }

    .card {
      background: white;
      padding: 1.5rem 1rem 2rem;
      border-radius: 14px;
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.05);
    }

    .embed-wrapper {
      width: 100%;
    }
  </style>
</head>

<body>

  <div class="container">

    <header class="header">
      <div class="names">HANNAH &amp; BRIAN</div>
      <div class="hebrew">חנה רבקה ומיכאל</div>
      <div class="date-line">SUNDAY, MAY 24, 2028 • CHUPPAH AT 6:00 PM</div>
    </header>

    <h1 class="rsvp-title">RSVP</h1>

    <div class="card">
      <div class="embed-wrapper">
        <!-- ★ The ONLY script required — safe with your CSP ★ -->
        <script type="text/javascript" src="https://brianandhannah.rsvpify.com/embed"></script>
        <noscript>
          Please visit
          <a href="https://brianandhannah.rsvpify.com" target="_blank">
            the RSVP page
          </a>
          to respond.
        </noscript>
      </div>
    </div>

  </div>

</body>
</html>