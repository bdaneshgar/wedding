<style>
  .rsvp-wrapper {
    position: fixed;
    inset: 0;                 /* full screen */
    width: 100%;
    height: 100%;
    background: #faf9f6;
    margin: 0;
    padding: 0;
    overflow: hidden;
    -webkit-overflow-scrolling: touch;
  }

  .rsvp-iframe {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: none;
  }

  /* Fix for iOS Safari dynamic toolbar shrinking viewport */
  @supports (-webkit-touch-callout: none) {
